# Brain Tumor AI - backend environment configuration.
# Copy to `.env` and adjust. Never commit the real `.env`.

# ---- Application -----------------------------------------------------------
APP_NAME=Brain Tumor AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

HOST=127.0.0.1
PORT=8000

# ---- Database --------------------------------------------------------------
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///./data/brain_tumor_ai.db
# MariaDB/MySQL (persistent multi-user deployment):
# DATABASE_URL=mysql+pymysql://brain_tumor:CHANGE_ME@127.0.0.1:3306/brain_tumor

# ---- Data directories (paths are resolved relative to the repo root) -------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
GRADCAM_DIR=./data/gradcam
REPORT_DIR=./data/reports
MODEL_DIR=./backend/models
REGISTRY_PATH=./backend/models/registry.json

# ---- Security --------------------------------------------------------------
SECRET_KEY=change-me-in-production
# Set a strong random value to enable the /api/v1/admin endpoints (send it in the X-Admin-Key header).
ADMIN_API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Upload constraints ----------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=[".jpg",".jpeg",".png",".bmp",".tif",".tiff"]
MIN_IMAGE_DIMENSION=64

# ---- Rate limiting (requests per minute per IP) ----------------------------
PREDICTION_RATE_LIMIT=6
REPORT_RATE_LIMIT=10
HEALTH_RATE_LIMIT=30

# ---- Model -----------------------------------------------------------------
ACTIVE_MODEL_NAME=Brain Tumor CNN
MODEL_TIMEOUT_SECONDS=60

# ---- Reporting -------------------------------------------------------------
REPORT_COMPANY_NAME=Brain Tumor AI